# --- LLM: fake (local, sin credenciales) | azure_openai ---
LLM_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# --- Autenticación (JWT HS256 simulado en local; en Azure: Entra ID) ---
# Mínimo 32 caracteres. Genera tokens con: python -m agent_api.adapters.inbound.cli.issue_token E001
JWT_SECRET=cambia-este-secreto-de-desarrollo-32+chars
JWT_ISSUER=
JWT_AUDIENCE=

# --- Cliente MCP: stdio (lanza el servidor como subproceso) | streamable-http ---
MCP_CLIENT_TRANSPORT=stdio
# stdio: por defecto "<python> -m mcp_server" (requiere `pip install -e ../mcp-server`)
MCP_SERVER_COMMAND=
MCP_SERVER_CWD=
# streamable-http
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=10
MCP_MAX_RETRIES=2

# --- Allowlist de tools por rol (JSON). Vacío = valores por defecto ---
TOOL_ALLOWLIST=

# --- Observabilidad ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
