meta {
  name: 04 Analista de riesgos (E002)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/docs/query
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenE002}}
}
body:json {
  {
    "employee_id": "E002",
    "role": "analista_riesgos",
    "area": "riesgos",
    "query": "metodología de scoring de riesgo"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("ve confidencial de su area, nada de otras", function () {
    expect(res.body.citations).to.include("DOC-004");
    res.body.citations.forEach((id) => expect(["DOC-004", "DOC-007", "DOC-008"]).to.include(id));
  });
}

docs {
  Requiere tokenE002. Clasificación máxima confidencial pero solo en el área riesgos.
}
